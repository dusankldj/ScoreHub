<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:MAUI.DTO.Input"
             xmlns:helpers="clr-namespace:MAUI.Helpers"
             xmlns:partials="clr-namespace:MAUI.Views.Partials"
             x:Class="MAUI.Views.TeamPage">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="0">

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="12"
                   HorizontalOptions="Center" />

            <!-- Logo levo (veci nego na EventDetailsPage), ime desno - ispod imena sport, pa ispod
                 sporta zastavica zemlje iz koje tim dolazi (ili planeta za nepoznatu/World/Worldwide/
                 International, vidi TeamDTO.FlagImage) - OBRNUT redosled u odnosu na LeaguePage
                 (ovde ide sport pa zastavica, tamo ide odmah zastavica). -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,0,16">
                <Image Grid.Column="0"
                       Source="{Binding Details.ImageUrl}"
                       HeightRequest="90"
                       WidthRequest="90"
                       VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                    <Label Text="{Binding Details.NameDisplay}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1A1A2E"
                           LineBreakMode="WordWrap" />

                    <Label Text="{Binding Details.SportName}"
                           IsVisible="{Binding HasSportName}"
                           FontAttributes="Italic"
                           TextColor="#8A8A8A"
                           FontSize="13" />

                    <Image Source="{Binding Details.FlagImage}"
                           IsVisible="{Binding Details.HasFlag}"
                           WidthRequest="26"
                           HeightRequest="19"
                           HorizontalOptions="Start" />

                    <Label Text="{x:Static helpers:Icons.PlanetIcon}"
                           IsVisible="{Binding Details.NoFlag}"
                           FontFamily="FA7Solid"
                           FontSize="18"
                           TextColor="#1A1A2E"
                           HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Grid>

            <!-- Stadion, levo poravnat -->
            <Label Text="{Binding Details.Stadium, StringFormat='Venue: {0}'}"
                   IsVisible="{Binding HasStadium}"
                   TextColor="#8A8A8A"
                   FontSize="14"
                   Margin="0,10,0,16" />

            <!-- "Add/Remove from favorite teams" - login-gate + animacija + stvarno cuvanje u
                 FavoriteTeams tabeli (vidi code-behind). -->
            <Border x:Name="FavoriteButtonBorder"
                    BackgroundColor="#1A1A2E"
                    Padding="16,10"
                    HorizontalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFavoriteButtonTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding FavoriteButtonText}" TextColor="White" FontSize="13" VerticalOptions="Center" />
                    <Label Text="{Binding FavoriteButtonIcon}"
                           FontFamily="{Binding FavoriteButtonIconFontFamily}"
                           TextColor="#D32F2F"
                           FontSize="15"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,20,0,20" />

            <!-- Matches / Team members / Team equipment tabovi - prikazuje se samo tab za koji
                 STVARNO ima podataka; ceo blok se sakriva ako nema nijednog. Isti fade-switch
                 obrazac kao Lineup/Statistics na EventDetailsPage. -->
            <VerticalStackLayout Margin="-20,0,-20,0" IsVisible="{Binding HasAnyTabData}">

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="24" Margin="20,0,20,8">
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasMatches}">
                        <Label Text="Matches" FontAttributes="Bold" TextColor="#1A1A2E" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMatchesTabTapped" />
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsMatchesSelected}" Value="False">
                                    <Setter Property="TextColor" Value="#8A8A8A" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <BoxView HeightRequest="2" WidthRequest="60" BackgroundColor="#1A1A2E" IsVisible="{Binding IsMatchesSelected}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasSquad}">
                        <Label Text="Team members" FontAttributes="Bold" TextColor="#1A1A2E" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSquadTabTapped" />
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSquadSelected}" Value="False">
                                    <Setter Property="TextColor" Value="#8A8A8A" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <BoxView HeightRequest="2" WidthRequest="100" BackgroundColor="#1A1A2E" IsVisible="{Binding IsSquadSelected}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" IsVisible="{Binding HasEquipment}">
                        <Label Text="Team equipment" FontAttributes="Bold" TextColor="#1A1A2E" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEquipmentTabTapped" />
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsEquipmentSelected}" Value="False">
                                    <Setter Property="TextColor" Value="#8A8A8A" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <BoxView HeightRequest="2" WidthRequest="110" BackgroundColor="#1A1A2E" IsVisible="{Binding IsEquipmentSelected}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Grid x:Name="TabContentContainer">

                    <!-- Matches - carousel, jedna utakmica po kartici; pozicioniran na
                         poslednju odigranu (TeamViewModel.SelectedMatchIndex), swajp
                         levo/desno = animacija koju CarouselView daje besplatno.
                         NAMERNO bez Position binding-a - TwoWay Position ume da "kliza" na 0
                         dok je ItemsSource jos prazan i to ONDA piso nazad u SelectedMatchIndex,
                         pa je pozicioniranje iskljucivo preko eksplicitnog ScrollTo u code-behind-u. -->
                    <CarouselView x:Name="MatchesCarousel"
                                  ItemsSource="{Binding Details.Matches}"
                                  IsVisible="{Binding IsMatchesSelected}"
                                  Loop="False"
                                  PeekAreaInsets="0"
                                  HeightRequest="220">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="dto:TeamMatches">
                                <!-- Kartica + strelice u gornjim uglovima: desna (RightArrowLongIcon) vodi na sledeci mec,
                                     leva (ista ikonica zarotirana 180) na prethodni. Prvi mec nema levu, poslednji desnu
                                     (IsFirst / IsLast). Tap na strelicu pomera carousel, tap na karticu otvara mec. -->
                                <Grid BackgroundColor="#1A1A2E">
                                <VerticalStackLayout BackgroundColor="#1A1A2E" Padding="16" Spacing="4">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMatchCardTapped" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Label Text="{Binding League, StringFormat='{0}'}"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           HorizontalOptions="Center" />

                                    <Label Text="{Binding Season}"
                                           TextColor="#B0B0C0"
                                           FontSize="12"
                                           HorizontalOptions="Center" />

                                    <Label Text="{Binding Round, StringFormat='Round {0}'}"
                                           IsVisible="{Binding HasRound}"
                                           TextColor="#B0B0C0"
                                           FontSize="12"
                                           HorizontalOptions="Center" />

                                    <Label Text="Live"
                                           IsVisible="{Binding IsLive}"
                                           TextColor="#D32F2F"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           HorizontalOptions="Center" />

                                    <Label Text="{Binding DateTimeText}"
                                           TextColor="#B0B0C0"
                                           FontSize="12"
                                           HorizontalOptions="Center"
                                           Margin="0,0,0,12" />

                                    <Grid ColumnDefinitions="*,Auto,*">
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="6">
                                            <Image Source="{Binding HomeTeamLogo}" HeightRequest="48" WidthRequest="48" />
                                            <Label Text="{Binding HomeTeamDisplayName}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                            <Label Text="{Binding HomeTeamScore}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                                            <Label Text=":" TextColor="White" FontSize="22" FontAttributes="Bold" />
                                            <Label Text="{Binding AwayTeamScore}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                                        </HorizontalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="6">
                                            <Image Source="{Binding AwayTeamLogo}" HeightRequest="48" WidthRequest="48" />
                                            <Label Text="{Binding AwayTeamDisplayName}"
                                                   TextColor="White"
                                                   FontSize="12"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <Label Text="{x:Static helpers:Icons.RightArrowLongIcon}"
                                       FontFamily="FA7Solid"
                                       FontSize="18"
                                       TextColor="White"
                                       Rotation="180"
                                       Padding="12"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Start"
                                       IsVisible="{Binding HasPrevious}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPreviousMatchTapped" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label Text="{x:Static helpers:Icons.RightArrowLongIcon}"
                                       FontFamily="FA7Solid"
                                       FontSize="18"
                                       TextColor="White"
                                       Padding="12"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start"
                                       IsVisible="{Binding HasNext}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNextMatchTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Team members -->
                    <VerticalStackLayout BackgroundColor="#1A1A2E"
                                          Padding="16"
                                          IsVisible="{Binding IsSquadSelected}"
                                          BindableLayout.ItemsSource="{Binding Details.Squad}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:Squad">
                                <VerticalStackLayout>
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlayerRowTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="10" Margin="0,8">
                                        <Image Source="{Binding ImageUrl}"
                                               IsVisible="{Binding HasImage}"
                                               HeightRequest="40"
                                               WidthRequest="40">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnPlayerImageTapped" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                        <Label Text="{x:Static helpers:Icons.UserIcon}"
                                               IsVisible="{Binding NoImage}"
                                               FontFamily="FA7Solid"
                                               FontSize="28"
                                               TextColor="White"
                                               WidthRequest="40"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />

                                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding PlayerDisplay}" TextColor="White" FontSize="13" />
                                            <Label Text="{Binding Position}" TextColor="#B0B0C0" FontSize="11" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                    <BoxView HeightRequest="1" BackgroundColor="#33FFFFFF" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Team equipment -->
                    <VerticalStackLayout BackgroundColor="#1A1A2E"
                                          Padding="16"
                                          IsVisible="{Binding IsEquipmentSelected}"
                                          BindableLayout.ItemsSource="{Binding Details.Equipment}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:TeamEquipment">
                                <VerticalStackLayout>
                                    <HorizontalStackLayout Spacing="10" Margin="0,8">
                                        <Image Source="{Binding ImageUrl}" HeightRequest="100" WidthRequest="100" />
                                        <Label Text="{Binding Type}" TextColor="White" FontSize="13" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <BoxView HeightRequest="1" BackgroundColor="#33FFFFFF" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </Grid>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
    <partials:LoadingOverlay IsLoading="{Binding IsBusy}" />
    </Grid>
</ContentPage>
