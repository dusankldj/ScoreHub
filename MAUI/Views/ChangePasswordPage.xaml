<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:partials="clr-namespace:MAUI.Views.Partials"
             x:Class="MAUI.Views.ChangePasswordPage"
             BackgroundColor="#1A1A2E"
             Shell.BackgroundColor="#1A1A2E"
             Shell.ForegroundColor="White"
             Shell.TitleColor="White">

    <!-- Isti izgled kao SettingsPage (teget pozadina, bela slova). Tri polja: trenutna, nova i ponovljena nova lozinka. -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,24,24,32" Spacing="14">

                <Label Text="Change password"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,8" />

                <Border BackgroundColor="#26264A" Stroke="#3A3A55" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                    <Entry Placeholder="Current password"
                           Text="{Binding CurrentPassword}"
                           IsPassword="{Binding HidePasswords}"
                           TextColor="White"
                           PlaceholderColor="#B8BECC"
                           BackgroundColor="Transparent"
                           ReturnType="Next" />
                </Border>

                <Border BackgroundColor="#26264A" Stroke="#3A3A55" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                    <Entry Placeholder="New password"
                           Text="{Binding NewPassword}"
                           IsPassword="{Binding HidePasswords}"
                           TextColor="White"
                           PlaceholderColor="#B8BECC"
                           BackgroundColor="Transparent"
                           ReturnType="Next" />
                </Border>

                <Border BackgroundColor="#26264A" Stroke="#3A3A55" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,0">
                    <Entry Placeholder="Repeat new password"
                           Text="{Binding RepeatNewPassword}"
                           IsPassword="{Binding HidePasswords}"
                           TextColor="White"
                           PlaceholderColor="#B8BECC"
                           BackgroundColor="Transparent"
                           ReturnType="Done" />
                </Border>

                <Label Text="{Binding TogglePasswordsText}"
                       FontSize="13"
                       TextColor="#C5CAD6"
                       TextDecorations="Underline"
                       HorizontalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding TogglePasswordsCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Label Text="Use at least 8 characters. After the change, other devices will be signed out."
                       FontSize="12"
                       FontAttributes="Italic"
                       TextColor="#B8BECC" />

                <Button Text="Change password"
                        Command="{Binding ChangePasswordCommand}"
                        BackgroundColor="White"
                        TextColor="#1A1A2E"
                        CornerRadius="8"
                        HeightRequest="48"
                        Margin="0,6,0,0" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#FF8A80"
                       FontSize="13"
                       FontAttributes="Italic"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding SuccessMessage}"
                       TextColor="#A5D6A7"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <partials:LoadingOverlay IsLoading="{Binding IsBusy}" />
    </Grid>
</ContentPage>
