<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:MAUI.Helpers"
             x:Class="MAUI.Views.ImagePreviewPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Image x:Name="PreviewImage" Aspect="AspectFit" Margin="20" />

        <Label Text="{x:Static helpers:Icons.XIcon}"
               FontFamily="FA7Solid"
               FontSize="26"
               TextColor="White"
               HorizontalOptions="End"
               VerticalOptions="Start"
               Padding="16"
               Margin="0,30,0,0">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped" />
            </Label.GestureRecognizers>
        </Label>
    </Grid>
</ContentPage>
