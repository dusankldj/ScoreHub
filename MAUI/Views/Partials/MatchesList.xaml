<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:MAUI.DTO.Input"
             xmlns:helpers="clr-namespace:MAUI.Helpers"
             x:Class="MAUI.Views.Partials.MatchesList"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Spacing="0">

            <Picker x:Name="StatusPicker"
                    ItemsSource="{Binding StatusOptions, Source={x:Reference Root}}"
                    ItemDisplayBinding="{Binding DisplayText}"
                    SelectedIndexChanged="OnStatusPickerSelectedIndexChanged"
                    IsEnabled="{Binding IsPickerEnabled, Source={x:Reference Root}}"
                    Margin="10,8"
                    WidthRequest="110"
                    TextColor="#1A1A2E" />

            <Picker x:Name="DatePicker"
                    ItemsSource="{Binding DateOptions, Source={x:Reference Root}}"
                    ItemDisplayBinding="{Binding DisplayText}"
                    SelectedIndexChanged="OnDatePickerSelectedIndexChanged"
                    IsEnabled="{Binding IsPickerEnabled, Source={x:Reference Root}}"
                    Margin="0,8,10,8"
                    WidthRequest="140"
                    TextColor="#1A1A2E" />

        </HorizontalStackLayout>

    <ScrollView Grid.Row="1">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Matches, Source={x:Reference Root}}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="dto:MatchesDTO">
                    <VerticalStackLayout Spacing="0" Margin="0,12,0,0">

                        <Label Text="{Binding SportName}"
                               FontAttributes="Bold"
                               FontSize="17"
                               TextTransform="Uppercase"
                               CharacterSpacing="0.5"
                               TextColor="#1A1A2E"
                               Padding="10,4,10,4" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Leagues}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:LeaguesDTO">
                                    <VerticalStackLayout Spacing="0">

                                        <!-- league logo/trophy icon -->
                                        <Grid BackgroundColor="#1A1A2E"
                                              Padding="10,4"
                                              ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8"
                                              HorizontalOptions="Fill">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding LeagueSelectedCommand, Source={x:Reference Root}}"
                                                                      CommandParameter="{Binding LeagueId}" />
                                            </Grid.GestureRecognizers>

                                            <Image Grid.Column="0"
                                                   Source="{Binding LeagueLogoUrl}"
                                                   IsVisible="{Binding HasLeagueLogo}"
                                                   HeightRequest="28"
                                                   WidthRequest="28"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="0"
                                                   Text="{x:Static helpers:Icons.TrophyIcon}"
                                                   IsVisible="{Binding NoLeagueLogo}"
                                                   FontFamily="FA7Solid"
                                                   FontSize="22"
                                                   TextColor="White"
                                                   WidthRequest="28"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding LeagueName}"
                                                   FontAttributes="Italic"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Events}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="dto:EventsDTO">
                                                    <VerticalStackLayout Spacing="0">
                                                        <Grid Padding="10,8" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                                            <Grid.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding EventSelectedCommand, Source={x:Reference Root}}"
                                                                                      CommandParameter="{Binding EventId}" />
                                                            </Grid.GestureRecognizers>
                                                            <Label Grid.Column="0" Text="{Binding TimeDisplay}" FontSize="12" VerticalOptions="Center" WidthRequest="40">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Live">
                                                                        <Setter Property="TextColor" Value="#D32F2F" />
                                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                            <Image Grid.Column="1" Source="{Binding HomeTeamLogoUrl}" HeightRequest="24" WidthRequest="24" />

                                                            <Label Grid.Column="2" Text="{Binding HomeTeamScore}" VerticalOptions="Center">
                                                                <Label.Behaviors>
                                                                    <helpers:ScoreFlashBehavior />
                                                                </Label.Behaviors>
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Live">
                                                                        <Setter Property="TextColor" Value="#D32F2F" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>

                                                            <Label Grid.Column="3" Text=" - " VerticalOptions="Center">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Live">
                                                                        <Setter Property="TextColor" Value="#D32F2F" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>

                                                            <Label Grid.Column="4" Text="{Binding AwayTeamScore}" VerticalOptions="Center">
                                                                <Label.Behaviors>
                                                                    <helpers:ScoreFlashBehavior />
                                                                </Label.Behaviors>
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Live">
                                                                        <Setter Property="TextColor" Value="#D32F2F" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>

                                                            <Image Grid.Column="5" Source="{Binding AwayTeamLogoUrl}" HeightRequest="24" WidthRequest="24" HorizontalOptions="Start" />

                                                            <Label Grid.Column="6" Text="{Binding Status}" FontSize="11" TextColor="#8A8A8A" VerticalOptions="Center">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Live">
                                                                        <Setter Property="TextColor" Value="#D32F2F" />
                                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                        </Grid>

                                                        <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" />
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>

    <Label Grid.Row="1"
           Text="No events"
           IsVisible="{Binding ShowNoMatches, Source={x:Reference Root}}"
           TextColor="#1A1A2E"
           FontSize="20"
           FontAttributes="Bold"
           HorizontalOptions="Center"
           VerticalOptions="Center" />

    </Grid>
</ContentView>