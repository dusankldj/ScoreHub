<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:MAUI.Helpers"
             xmlns:services="clr-namespace:MAUI.Services"
             x:Class="MAUI.Views.Partials.NavMenu"
             x:Name="Root">

    <Grid>

        
        <Grid RowDefinitions="Auto,Auto,Auto">

            <!-- first track -->
            <Grid Grid.Row="0" Padding="0,4" BackgroundColor="#1A1A2E">
                <Image Source="scorehub_160x90px_v2.png"
                       HeightRequest="75"
                       WidthRequest="75"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       SemanticProperties.Description="ScoreHub logo">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoTapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>

            <!-- second track -->
            <Grid Grid.Row="1" BackgroundColor="White" x:Name="SecondBarGrid">

                <Grid Padding="16,10" ColumnDefinitions="*,Auto">

                    <!-- first 4 sports -->
                    <HorizontalStackLayout Grid.Column="0"
                                           HorizontalOptions="Start"
                                           Spacing="14"
                                           BindableLayout.ItemsSource="{Binding Sports, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="services:SportMenuItem">
                                <HorizontalStackLayout Spacing="4">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSportTapped" CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding IconGlyph}"
                                           FontFamily="{Binding IconFontFamily}"
                                           FontSize="14"
                                           TextColor="#1A1A2E"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding Name}"
                                           FontSize="13"
                                           TextColor="#1A1A2E"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Label Grid.Column="1"
                           Text="{x:Static helpers:Icons.HamburgerIcon}"
                           FontFamily="FA7Solid"
                           FontSize="20"
                           TextColor="#1A1A2E"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSportsMenuTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <BoxView HeightRequest="2"
                         BackgroundColor="#1A1A2E"
                         VerticalOptions="End" />
            </Grid>

            <!-- third track -->
            <Grid Grid.Row="2" BackgroundColor="White">

                <Grid Padding="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <!-- search field -->
                    <Border Grid.Column="0"
                            BackgroundColor="#F2F2F2"
                            Stroke="#E0E0E0"
                            StrokeThickness="1"
                            Padding="14,0"
                            HeightRequest="40"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{x:Static helpers:Icons.SearchIcon}"
                                   FontFamily="FA7Solid"
                                   FontSize="14"
                                   TextColor="#8A8A8A"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   x:Name="SearchEntry"
                                   Placeholder="Search teams, leagues..."
                                   PlaceholderColor="#8A8A8A"
                                   TextColor="#1A1A2E"
                                   FontSize="14"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   Focused="OnSearchEntryFocused"
                                   Unfocused="OnSearchEntryUnfocused"
                                   Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Grid.Column="1" Spacing="17" VerticalOptions="Center">
                        <Label Text="{x:Static helpers:Icons.ProfileIcon}"
                               FontFamily="FA7Solid"
                               FontSize="22"
                               TextColor="#1A1A2E"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAccountMenuTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </Grid>

                <BoxView HeightRequest="2"
                         BackgroundColor="#1A1A2E"
                         VerticalOptions="End" />
            </Grid>
        </Grid>

        <!-- other sports menu -->
        <Border x:Name="OverflowMenuBorder"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#1A1A2E"
                StrokeThickness="1"
                Padding="0"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                TranslationY="133"
                WidthRequest="220"
                ZIndex="10">
            
            <CollectionView ItemsSource="{Binding OverflowSports, Source={x:Reference Root}}"
                            HeightRequest="450"
                            SelectionMode="Single"
                            SelectionChanged="OnOverflowSportSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:SportMenuItem">
                        <Grid Padding="16,10" ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Text="{Binding IconGlyph}"
                                   FontFamily="{Binding IconFontFamily}"
                                   FontSize="18"
                                   TextColor="#1A1A2E"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   Margin="10,0,0,0"
                                   TextColor="#1A1A2E"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- menu with search results -->
        <Border x:Name="SearchResultsBorder"
                IsVisible="{Binding IsSearchResultsVisible, Source={x:Reference Root}}"
                BackgroundColor="White"
                Stroke="#1A1A2E"
                StrokeThickness="1"
                Padding="0"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                Margin="10,175,70,0"
                ZIndex="10">
            <Grid RowDefinitions="Auto,*">

            <!-- Naslov sa "Clear all" - samo kad dropdown prikazuje "Recent searches" (ulogovan korisnik,
                 fokus na prazno polje), ne kod obicnih rezultata pretrage. -->
            <Grid Grid.Row="0"
                  IsVisible="{Binding IsShowingRecents, Source={x:Reference Root}}"
                  Padding="16,10,16,4"
                  ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="Recent searches"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#8A8A8A"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Clear all"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#D32F2F"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClearRecentsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Grid Grid.Row="1">
            <Label Text="No results"
                   IsVisible="{Binding HasNoSearchResults, Source={x:Reference Root}}"
                   TextColor="#8A8A8A"
                   FontSize="14"
                   Padding="16,14"
                   HorizontalOptions="Center" />
            <CollectionView ItemsSource="{Binding SearchResults, Source={x:Reference Root}}"
                            HeightRequest="260"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:SearchResultItem">
                            <Grid Padding="16,10" ColumnDefinitions="40,*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSearchResultTapped" />
                                </Grid.GestureRecognizers>
                                <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}"
                                   IsVisible="{Binding HasImage}"
                                   Aspect="AspectFill"
                                   HeightRequest="40"
                                   WidthRequest="40"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="0"
                                   Text="{Binding IconGlyph}"
                                   IsVisible="{Binding NoImage}"
                                   FontFamily="FA7Solid"
                                   FontSize="20"
                                   TextColor="#1A1A2E"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   FontSize="15"
                                   Margin="10,0,0,0"
                                   TextColor="#1A1A2E"
                                   VerticalOptions="Center"
                                   LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                <Label Text="{Binding KindLabel}"
                                       FontSize="11"
                                       TextColor="#8A8A8A"
                                       VerticalOptions="Center" />

                                <!-- X - samo uz stavke iz "Recent searches" (IsRecent); uklanja SAMO tu stavku.
                                     Padding je zbog vece povrsine za tap. -->
                                <Label Text="{x:Static helpers:Icons.XIcon}"
                                       IsVisible="{Binding IsRecent}"
                                       FontFamily="FA7Solid"
                                       FontSize="14"
                                       TextColor="#8A8A8A"
                                       Padding="8"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoveRecentTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </Grid>
            </Grid>
        </Border>

        <!-- menu for account -->
        <Border x:Name="AccountMenuBorder"
                IsVisible="False"
                BackgroundColor="White"
                Stroke="#1A1A2E"
                StrokeThickness="1"
                Padding="0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,175,0,0"
                WidthRequest="160"
                ZIndex="10">
            <VerticalStackLayout>
                <Label Text="Profile Info"
                       Padding="16,12"
                       FontSize="15"
                       TextColor="#1A1A2E">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProfileInfoTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" BackgroundColor="#1A1A2E" />
                <Label Text="Logout"
                       Padding="16,12"
                       FontSize="15"
                       TextColor="#D32F2F">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
