<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:partials="clr-namespace:MAUI.Views.Partials"
             x:Class="MAUI.Views.ForgotPasswordPage"
             Title="">

    <!-- Tri koraka na jednoj stranici (isto kao Login: svetla pozadina, teget dugmad): 1) e-mail, 2) sestocifreni kod,
         3) nova lozinka. Vidljiv je samo panel trenutnog koraka. -->
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="30" Spacing="16" VerticalOptions="Center">

                <Label Text="Forgot password"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#1A1A2E" />

                <!-- Korak 1: e-mail -->
                <VerticalStackLayout IsVisible="{Binding IsEmailStep}" Spacing="16">
                    <Label Text="Enter the email address of your account and we will send you a 6-digit code."
                           FontSize="14"
                           TextColor="#555555"
                           HorizontalTextAlignment="Center" />

                    <Entry Placeholder="Email"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           ReturnType="Done" />

                    <Button Text="Send code"
                            Command="{Binding SendCodeCommand}"
                            BackgroundColor="#1A1A2E"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48" />
                </VerticalStackLayout>

                <!-- Korak 2: kod -->
                <VerticalStackLayout IsVisible="{Binding IsCodeStep}" Spacing="16">
                    <Label Text="{Binding SentToText}" FontSize="14" TextColor="#1A1A2E" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding ExpiresText}" FontSize="12" FontAttributes="Italic" TextColor="#8A8A8A" HorizontalTextAlignment="Center" />

                    <Entry Placeholder="6-digit code"
                           Text="{Binding Code}"
                           Keyboard="Numeric"
                           MaxLength="6"
                           FontSize="22"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Confirm"
                            Command="{Binding ConfirmCodeCommand}"
                            BackgroundColor="#1A1A2E"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48" />

                    <Label Text="{Binding ResendText}"
                           FontSize="14"
                           TextDecorations="Underline"
                           TextColor="#1A1A2E"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResendCodeCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="Use a different email"
                           FontSize="14"
                           TextColor="#8A8A8A"
                           HorizontalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartOverCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Korak 3: nova lozinka -->
                <VerticalStackLayout IsVisible="{Binding IsPasswordStep}" Spacing="16">
                    <Label Text="Choose a new password (at least 8 characters)."
                           FontSize="14"
                           TextColor="#555555"
                           HorizontalTextAlignment="Center" />

                    <Entry Placeholder="New password"
                           Text="{Binding NewPassword}"
                           IsPassword="{Binding HidePasswords}"
                           ReturnType="Next" />

                    <Entry Placeholder="Repeat new password"
                           Text="{Binding RepeatPassword}"
                           IsPassword="{Binding HidePasswords}"
                           ReturnType="Done" />

                    <Label Text="{Binding TogglePasswordsText}"
                           FontSize="13"
                           TextDecorations="Underline"
                           TextColor="#1A1A2E"
                           HorizontalOptions="Start">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Button Text="Change password"
                            Command="{Binding ResetPasswordCommand}"
                            BackgroundColor="#1A1A2E"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="48" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="Red"
                       FontSize="12"
                       FontAttributes="Italic"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <partials:LoadingOverlay IsLoading="{Binding IsBusy}" />
    </Grid>
</ContentPage>
